{
  "manifest_version": 3,
  "name": "Onipat v3.09.3-release-1 Liquid Prism",
  "version": "3.9.3.1",
  "description": "__MSG_appDescription__",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Option+F"
      }
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "default_locale": "en"
}